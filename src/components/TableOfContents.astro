---
import type { MarkdownHeading } from "astro"
import type { Locale } from "@/lib/i18n"
import { groupTocHeadings } from "@/lib/table-of-contents"

interface Props {
  headings: MarkdownHeading[]
  locale: Locale
}

const { headings, locale } = Astro.props
const label = locale === "es" ? "En esta página" : "On this page"
const entries = groupTocHeadings(headings)
---

<aside class="table-of-contents">
  <nav aria-label={label}>
    <h2>{label}</h2>
    <ol class="toc-list">
      {
        entries.map(({ heading, index, children }) => (
          <li>
            <div
              class="toc-row"
              style={`--section-timeline: --toc-section-${index}; --previous-section-timeline: --toc-section-${Math.max(0, index - 1)}`}
            >
              <a class="toc-link link-underline" href={`#${heading.slug || `toc-section-${index}`}`}>
                {heading.text}
              </a>
            </div>
            {children.length > 0 && (
              <ol class="toc-sublist">
                {children.map(({ heading, index }) => (
                  <li>
                    <div
                      class="toc-row"
                      style={`--section-timeline: --toc-section-${index}; --previous-section-timeline: --toc-section-${index - 1}`}
                    >
                      <a class="toc-link link-underline" href={`#${heading.slug || `toc-section-${index}`}`}>
                        {heading.text}
                      </a>
                    </div>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))
      }
    </ol>
  </nav>
</aside>

<style>
  .table-of-contents {
    display: none;
  }

  @media (width >= 1280px) {
    .table-of-contents {
      position: absolute;
      inset-block: 0;
      left: calc(100% + 2rem);
      display: block;
      width: 14rem;
    }

    nav {
      position: sticky;
      top: 6rem;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }

    h2 {
      margin-bottom: 0.75rem;
      font-size: 0.875rem;
      font-weight: 500;
    }

    ol {
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .toc-row {
      --rail-offset: 0px;
      --connector-width: 0px;
      --arrival-offset: 0rem;
      position: relative;
      padding-left: 0.875rem;
    }

    .toc-sublist .toc-row {
      --rail-offset: 0.75rem;
      padding-left: 1.625rem;
    }

    .toc-sublist > li:first-child > .toc-row,
    .toc-list > li:has(> .toc-sublist) + li > .toc-row {
      --connector-width: calc(0.75rem + 2px);
    }

    /* H2/H3 timelines differ by the 1rem between their existing heading margins. */
    .toc-sublist > li:first-child > .toc-row {
      --arrival-offset: -1rem;
    }

    .toc-list > li:has(> .toc-sublist) + li > .toc-row {
      --arrival-offset: 1rem;
    }

    .toc-row::before,
    .toc-row::after {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(currentColor, currentColor) var(--rail-offset) 0 / 2px 100% no-repeat,
        linear-gradient(currentColor, currentColor) 0 0 / var(--connector-width) 2px no-repeat;
      pointer-events: none;
      content: "";
    }

    .toc-row::before {
      color: var(--border);
    }

    .toc-row::after {
      color: var(--primary);
      clip-path: inset(0 0 100% 0);
    }

    .toc-link {
      display: block;
      width: fit-content;
      max-width: 100%;
      padding-block: 0.375rem;
      color: var(--foreground);
      opacity: 0.6;
      font-size: 0.8125rem;
      line-height: 1.5;
      overflow-wrap: anywhere;
      text-decoration-line: none;
    }

    .toc-link:hover,
    .toc-link:focus-visible {
      text-decoration-line: underline;
    }

    .toc-link:focus-visible {
      outline: 2px solid var(--ring);
      outline-offset: -2px;
    }

    @supports (timeline-scope: --toc-section-0) and (animation-timeline: --toc-section-0) and
      (view-timeline-inset: 6rem calc(100% - 6rem)) {
      @media (prefers-reduced-motion: no-preference) {
        .toc-row::after {
          /* Finish this row's upper half before its section starts, then reveal its lower half. */
          animation:
            toc-arrive auto linear forwards,
            toc-leave auto linear forwards;
          animation-timeline: var(--previous-section-timeline), var(--section-timeline);
          animation-range:
            50% calc(100% + var(--arrival-offset)),
            0% 50%;
        }
      }
    }
  }

  @keyframes toc-arrive {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 50% 0);
    }
  }

  @keyframes toc-leave {
    from {
      clip-path: inset(0 0 50% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
</style>
