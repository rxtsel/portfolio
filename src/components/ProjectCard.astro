---
import type { ImageMetadata } from "astro"
import GitHubIcon from "@/assets/logos/github.svg"
import type { FaviconBackground } from "@/lib/favicon"
import type { ProjectTransitionPart } from "@/lib/projects"
import Tags from "./Tags.astro"
import FaviconResolver from "./FaviconResolver.astro"

type TaxonomyItem = {
  name: string
}

interface Props {
  customFavicon: string | ImageMetadata | undefined
  description: string
  faviconBackground?: FaviconBackground
  faviconLoading?: "lazy" | "eager"
  headingLevel?: "h2" | "h3"
  href: string | undefined
  sourceUrl: string | undefined
  taxonomyItems: TaxonomyItem[]
  title: string
  transitionNames?: Partial<Record<ProjectTransitionPart, string>>
}

const {
  customFavicon,
  description,
  faviconBackground = "none",
  faviconLoading = "lazy",
  headingLevel = "h3",
  href,
  sourceUrl,
  taxonomyItems,
  title,
  transitionNames = {},
} = Astro.props
const Heading = headingLevel
const isInternalLink = href?.startsWith("/") && !href.startsWith("//")
const getTransitionStyle = (part: ProjectTransitionPart) =>
  transitionNames[part] ? `view-transition-name: ${transitionNames[part]}` : undefined
const tagsStyle = getTransitionStyle("tags")
const tagsProps = tagsStyle ? { style: tagsStyle } : {}
---

<article class="flex h-full flex-col gap-2 p-4" style={getTransitionStyle("card")}>
  <Heading
    class="flex items-center justify-between text-lg font-medium"
    style={transitionNames.logo ? undefined : getTransitionStyle("title")}
  >
    {
      href ? (
        <a
          class="link-underline item-center flex gap-2"
          href={isInternalLink ? href : `${href}?utm_source=rxtsel.dev&utm_medium=referral`}
          rel={isInternalLink ? undefined : "noopener noreferrer"}
          target={isInternalLink ? undefined : "_blank"}
        >
          <FaviconResolver
            background={faviconBackground}
            customFavicon={customFavicon}
            href={href}
            loading={faviconLoading}
            transitionName={transitionNames.logo}
          />
          <span
            class:list={{ "leading-tight": Boolean(transitionNames.logo) }}
            style={transitionNames.logo ? getTransitionStyle("title") : undefined}
          >
            {title}
          </span>
        </a>
      ) : customFavicon ? (
        <span class="item-center flex gap-2">
          <FaviconResolver
            background={faviconBackground}
            customFavicon={customFavicon}
            href=""
            loading={faviconLoading}
            transitionName={transitionNames.logo}
          />
          <span
            class:list={{ "leading-tight": Boolean(transitionNames.logo) }}
            style={transitionNames.logo ? getTransitionStyle("title") : undefined}
          >
            {title}
          </span>
        </span>
      ) : (
        title
      )
    }

    {
      sourceUrl ? (
        <a
          aria-label={`View ${title} on GitHub`}
          href={`${sourceUrl}?utm_source=rxtsel.dev`}
          rel="noopener noreferrer"
          style={getTransitionStyle("source")}
          target="_blank"
          title="View source on GitHub"
        >
          <GitHubIcon class="text-foreground size-4.5 shrink-0" />
        </a>
      ) : (
        <span style={getTransitionStyle("source")}>
          <GitHubIcon class="size-4.5 shrink-0 opacity-40" />
        </span>
      )
    }
  </Heading>

  <p class="text-muted-foreground flex-1" style={getTransitionStyle("description")}>{description}</p>

  <Tags {...tagsProps} tags={taxonomyItems} />
</article>
