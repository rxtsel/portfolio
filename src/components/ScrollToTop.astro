---
import type { Locale } from "@/lib/i18n"
import Arrow from "@/assets/arrow.svg"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const label = locale === "es" ? "Volver arriba" : "Scroll to top"
---

<a
  aria-label={label}
  class="scroll-to-top bg-background text-muted-foreground hover:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 fixed right-4 bottom-4 z-50 flex size-8 items-center justify-center border backdrop-blur transition-colors outline-none focus-visible:ring-3 md:right-6 md:bottom-6"
  data-scroll-to-top
  href="#top"
>
  <Arrow aria-hidden="true" class="pointer-events-none size-4" />
</a>

<style>
  @supports (animation-timeline: scroll(root block)) and (animation-range: 1000px 1001px) {
    .scroll-to-top {
      visibility: hidden;
      animation: show-scroll-to-top auto steps(1, end) both;
      animation-timeline: scroll(root block);
      animation-range: 1000px 1001px;
    }
  }

  @keyframes show-scroll-to-top {
    from {
      visibility: hidden;
    }
    to {
      visibility: visible;
    }
  }
</style>
