---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import type { FaviconBackground } from "@/lib/favicon"

interface Props {
  customFavicon: string | ImageMetadata | undefined
  background?: FaviconBackground
  href: string | undefined
  loading?: "lazy" | "eager"
  transitionName?: string | undefined
}

const { background = "none", customFavicon, href, loading = "lazy", transitionName } = Astro.props

const shouldRender = customFavicon || (href && href.length > 0)

const src = customFavicon
  ? customFavicon
  : href
    ? `https://favicon.vemetric.com/${new URL(href).hostname}?format=webp&size=54`
    : ""
const alt = customFavicon ? "Custom favicon" : href ? `Favicon for ${new URL(href).hostname}` : ""
// Astro's Image props require imported assets and URL strings to remain separate types.
const imageSource = typeof src === "string" ? { src } : { src }
---

{
  shouldRender && (
    <Image
      alt={alt}
      class:list={["m-auto aspect-square shrink-0 object-contain", { "bg-white": background === "light" }]}
      densities={[1, 2, 3]}
      fit="contain"
      format="webp"
      height={18}
      loading={loading}
      quality={90}
      {...imageSource}
      style={transitionName ? `view-transition-name: ${transitionName}` : undefined}
      width={18}
    />
  )
}
