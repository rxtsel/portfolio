---
import type { CollectionEntry } from "astro:content"
import { renderSafeMarkdown } from "@/lib/markdown"
import type { Locale } from "@/lib/i18n"
import { formatExperienceRange } from "@/lib/date-time"
import { getProjectTaxonomyItems } from "@/lib/taxonomy"
import Tags from "./Tags.astro"

type ExperienceEntry = CollectionEntry<"experience">
type ExperienceItemData = ExperienceEntry["data"]["items"][number]
type ExperienceJob = ExperienceItemData["jobs"][number]
type StackEntry = CollectionEntry<"stack">
type TagsEntry = CollectionEntry<"tags">

interface Props {
  item: ExperienceItemData
  locale: Locale
  stackEntry: StackEntry
  tagsEntry: TagsEntry
}

const { item, locale, stackEntry, tagsEntry } = Astro.props

const labels = {
  en: {
    present: "Present",
    remote: "Remote",
  },
  es: {
    present: "Actualidad",
    remote: "Remoto",
  },
} satisfies Record<Locale, Record<string, string>>

function getJobEndDate(job: ExperienceJob) {
  return job.current ? "" : (job.endDate ?? "")
}

function getEarliestStartDate(jobs: ExperienceJob[]) {
  return [...jobs.map((job) => job.startDate)].sort()[0] ?? ""
}

function getLatestEndDate(jobs: ExperienceJob[]) {
  if (jobs.some((job) => job.current || !job.endDate)) {
    return ""
  }

  return [...jobs.map((job) => job.endDate).filter(Boolean)].sort().at(-1) ?? ""
}

const companyStartDate = getEarliestStartDate(item.jobs)
const companyEndDate = getLatestEndDate(item.jobs)
const companyIsCurrent = !companyEndDate
const shouldShowJobDates = item.jobs.length > 1
const sortedJobs = [...item.jobs].sort((current, next) => {
  const currentDate = current.current ? "9999-12-31" : current.endDate || current.startDate
  const nextDate = next.current ? "9999-12-31" : next.endDate || next.startDate

  return nextDate.localeCompare(currentDate)
})
---

<li class="experience-company relative my-0! ms-[20.5px] grid gap-4 ps-0!">
  <header class="experience-company-header">
    <span
      class="border-border bg-primary absolute inset-s-[-1.35rem] mt-1.5 block size-3 border lg:mt-2.5"
      role="none"></span>

    {
      item.companyUrl ? (
        <h3 class="my-0! text-lg leading-snug font-semibold">
          <a
            class="link-underline"
            href={`${item.companyUrl}?ref=rxtsel.dev`}
            rel="noopener noreferrer"
            target="_blank"
          >
            {item.company}
          </a>
        </h3>
      ) : (
        <h3 class="my-0! text-lg leading-snug font-semibold">{item.company}</h3>
      )
    }

    <time
      class="text-muted-foreground block text-sm"
      data-current={String(companyIsCurrent)}
      data-end={companyEndDate}
      data-experience-range
      data-start={companyStartDate}
      datetime={companyEndDate || companyStartDate}
    >
      {formatExperienceRange(companyStartDate, companyEndDate, locale)}
    </time>

    {
      (item.location || item.remote) && (
        <span class="text-muted-foreground block text-sm">
          {item.location}
          {item.location && item.remote ? " · " : ""}
          {item.remote ? labels[locale].remote : ""}
        </span>
      )
    }
  </header>

  <div class="space-y-4">
    {
      sortedJobs.map((job) => {
        const endDate = getJobEndDate(job)
        const taxonomyItems = getProjectTaxonomyItems({
          stackEntry,
          stackSlugs: job.stack,
          tagSlugs: job.tags,
          tagsEntry,
        })
        const descriptionHtml = job.description ? renderSafeMarkdown(job.description) : ""

        return (
          <article class="experience-job relative ml-[21.5px] grid gap-2">
            <span
              class="bg-border absolute inset-s-[-1.35rem] mt-[3px] block size-3 border lg:mt-[5.5px]"
              role="none"
            />

            <header>
              <h4 class="my-0! flex-1 leading-snug font-semibold text-balance">{job.role}</h4>
              {shouldShowJobDates ? (
                <time
                  class="text-muted-foreground block text-sm"
                  data-current={String(job.current)}
                  data-end={endDate}
                  data-experience-range
                  data-start={job.startDate}
                  datetime={endDate || job.startDate}
                >
                  {formatExperienceRange(job.startDate, endDate, locale)}
                </time>
              ) : null}
            </header>

            {descriptionHtml ? (
              <>
                {/* eslint-disable astro/no-set-html-directive */}
                <div
                  class="prose prose-sm prose-neutral dark:prose-invert lg:prose-sm prose-p:text-muted-foreground prose-li:text-muted-foreground prose-ul:list-disc!"
                  set:html={descriptionHtml}
                />
                {/* eslint-enable astro/no-set-html-directive */}
              </>
            ) : null}

            {taxonomyItems.length > 0 && <Tags class="prose-li:m-0! p-0!" tags={taxonomyItems} />}
          </article>
        )
      })
    }
  </div>
</li>

<style>
  .experience-company {
    /* Match the existing square centers and the 21.5px indentation without moving content. */
    --company-center: 0.75rem;
    --job-center: calc(3px + 0.375rem);
    --rail-start: calc(-1.35rem + 0.375rem);
  }

  @media (width >= 1024px) {
    .experience-company {
      --company-center: 1rem;
      --job-center: calc(5.5px + 0.375rem);
    }
  }

  .experience-company-header {
    position: relative;
  }

  .experience-company-header::before,
  .experience-company::after,
  .experience-job::before,
  .experience-job::after {
    position: absolute;
    background: var(--border);
    pointer-events: none;
  }

  .experience-company-header::before {
    inset-inline-start: var(--rail-start);
    top: var(--company-center);
    bottom: calc(-1rem - var(--job-center));
    width: 1px;
    content: "";
  }

  .experience-job::before {
    inset-inline-start: var(--rail-start);
    top: var(--job-center);
    bottom: calc(-1rem - var(--job-center));
    width: 1px;
    content: "";
  }

  .experience-job:first-child::after {
    inset-inline-start: calc(var(--rail-start) - 21.5px);
    top: var(--job-center);
    width: 22.5px;
    height: 1px;
    content: "";
  }

  .experience-job:last-child::before {
    bottom: 0;
  }

  .experience-company:not(:last-child)::after {
    inset-inline-start: var(--rail-start);
    top: 100%;
    width: 22.5px;
    height: calc(2rem + var(--company-center));
    background:
      linear-gradient(var(--border), var(--border)) 0 0 / 100% 1px no-repeat,
      linear-gradient(var(--border), var(--border)) 0 0 / 1px 100% no-repeat;
    content: "";
  }

  .experience-company:last-child .experience-job:last-child::before {
    content: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view(block 80% 20%)) {
      .experience-company-header::before,
      .experience-company::after,
      .experience-job::before,
      .experience-job::after {
        animation: experience-reveal auto linear both;
        animation-timeline: view(block 80% 20%);
      }
    }
  }

  @keyframes experience-reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
</style>
