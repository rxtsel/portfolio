---
import { Code } from "astro:components"
import { getCollection, render } from "astro:content"
import BugIcon from "@/assets/bug.svg"
import PageToolbar from "@/components/PageToolbar.astro"
import ContentWithToc from "@/components/ContentWithToc.astro"
import MainLayout from "@/layouts/MainLayout.astro"
import { getReadingMinutes, readBlogMarkdownContent } from "@/lib/blog-markdown"
import { getBlogPostAlternateHref, getBlogPostLanguageLinks, type BlogPost } from "@/lib/blog"
import { getAlternateBlogPosts, getLocaleLanguageTag, getLocalizedPath } from "@/lib/i18n"
import { formatBlogDate, toIsoDateTime } from "@/lib/date-time"
import { buildBlogPostGraph } from "@/lib/seo"
import { getCategoryItemsByTranslationKey } from "@/lib/taxonomy"

interface Props {
  post: BlogPost
  posts: BlogPost[]
}

const { post, posts } = Astro.props
const { Content, headings } = await render(post)
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3)
const canonical = new URL(getBlogPostAlternateHref(post), Astro.site).toString()
const issueUrl = new URL("https://github.com/rxtsel/portfolio/issues/new")
issueUrl.search = new URLSearchParams({
  template: "error.yml",
  title: `[Error] ${post.data.title}`,
  pagina: canonical,
}).toString()
const ogImage = new URL(`${getBlogPostAlternateHref(post)}/og.png`, Astro.site).toString()
const alternatePosts = getAlternateBlogPosts(posts, post)
const defaultAlternatePost = alternatePosts.find((entry) => entry.data.locale === "en") ?? post
const alternates = {
  defaultLocale: "en",
  entries: [
    ...alternatePosts.map((entry) => ({
      href: new URL(getBlogPostAlternateHref(entry), Astro.site).toString(),
      hreflang: getLocaleLanguageTag(entry.data.locale),
    })),
    {
      href: new URL(getBlogPostAlternateHref(defaultAlternatePost), Astro.site).toString(),
      hreflang: "x-default",
    },
  ],
}
const labels = {
  en: {
    categories: "Post categories",
    backToBlog: "Blog",
    content: "Article content",
    errorPrompt: "Found an error in this post?",
    reportError: "Let me know on GitHub.",
    published: "Published",
    readingTime: "min read",
    updated: "Updated",
  },
  es: {
    categories: "Categorías del artículo",
    backToBlog: "Blog",
    content: "Contenido del artículo",
    errorPrompt: "¿Has encontrado un error en este artículo?",
    reportError: "Avísame en GitHub.",
    published: "Publicado",
    readingTime: "min de lectura",
    updated: "Actualizado",
  },
}
const blogCategoriesEntries = await getCollection("blogCategories")
const blogCategoriesEntry = blogCategoriesEntries.find((entry) => entry.data.locale === post.data.locale)

if (!blogCategoriesEntry) {
  throw new Error(`Missing blogCategories for locale: ${post.data.locale}`)
}

const taxonomyItems = getCategoryItemsByTranslationKey(blogCategoriesEntry, post.data.categories).map(
  (category) => category.name,
)
const blogHref = getLocalizedPath(post.data.locale, "blog")
const markdown = await readBlogMarkdownContent(post.id)
const readingMinutes = getReadingMinutes(markdown)
const publishedDate = post.data.publishDate
const updatedDate = post.data.updatedDate
const lastModifiedDate = updatedDate ?? publishedDate
const seoDescription = post.data.seo.description
const graph = buildBlogPostGraph({
  description: seoDescription,
  image: ogImage,
  lang: post.data.locale,
  publishedDate,
  title: post.data.title,
  ...(updatedDate ? { updatedDate } : {}),
  url: canonical,
})
---

<MainLayout
  alternates={alternates}
  canonical={canonical}
  description={seoDescription}
  graph={graph}
  keywords={post.data.seo.keywords}
  lang={post.data.locale}
  languageLinks={getBlogPostLanguageLinks(posts, post)}
  ogImage={ogImage}
  title={post.data.title}
  titleTemplate="%s - Blog"
>
  <link blocking="render" href="#blog-post-content" rel="expect" slot="head" />
  <div aria-hidden="true" class="reading-progress"></div>
  <ContentWithToc headings={tocHeadings} locale={post.data.locale}>
    <main
      class="prose prose-neutral prose-p:text-pretty prose-sm lg:prose-base dark:prose-invert prose-a:wrap-break-word prose-code:wrap-break-word prose-pre:max-w-full prose-pre:overflow-x-auto prose-table:block prose-table:max-w-full prose-table:overflow-x-auto prose-headings:text-balance w-full max-w-full min-w-0 [&_.expressive-code]:max-w-full [&_.expressive-code]:overflow-x-auto [&_figure]:max-w-full"
    >
      <article data-blog-path={getBlogPostAlternateHref(post)}>
        <header>
          <PageToolbar
            backHref={blogHref}
            backLabel={labels[post.data.locale].backToBlog}
            locale={post.data.locale}
            markdown={markdown}
            markdownUrl={`${canonical.replace(/\/$/, "")}.md`}
            title={post.data.title}
            url={canonical}
          />

          <h1 data-blog-part="title">
            {post.data.title}
          </h1>

          <p data-blog-part="description">
            {post.data.description}
          </p>

          <div
            class="not-prose text-muted-foreground flex flex-wrap items-center justify-between gap-x-4 gap-y-2 text-sm"
          >
            <div class="flex flex-wrap items-center gap-x-1 gap-y-2">
              <span>{labels[post.data.locale].published}</span>
              <time
                data-blog-part={!updatedDate ? "date" : undefined}
                datetime={toIsoDateTime(publishedDate)}
              >
                {formatBlogDate(publishedDate, post.data.locale)}
              </time>
              {
                updatedDate && (
                  <>
                    <span aria-hidden="true" class="text-xs">
                      /
                    </span>
                    <span>{labels[post.data.locale].updated}</span>
                    <time data-blog-part="date" datetime={toIsoDateTime(lastModifiedDate)}>
                      {formatBlogDate(lastModifiedDate, post.data.locale)}
                    </time>
                  </>
                )
              }
            </div>
            <time class="ms-auto whitespace-nowrap" datetime={`PT${readingMinutes}M`}>
              ≈ {readingMinutes}
              {labels[post.data.locale].readingTime}
            </time>
          </div>

          {
            taxonomyItems.length > 0 && (
              <ul
                aria-label={labels[post.data.locale].categories}
                class="not-prose my-6 flex w-fit list-none flex-wrap gap-2 ps-0"
                data-blog-part="categories"
              >
                {taxonomyItems.map((category) => (
                  <li class="text-muted-foreground retina:border-[0.5px] inline-flex items-center rounded-none border bg-zinc-50 px-1.5 py-0.5 font-mono text-xs dark:bg-zinc-900">
                    {category}
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <section aria-label={labels[post.data.locale].content} id="blog-post-content">
          <Content components={{ pre: Code }} />
        </section>

        <footer class="not-prose text-muted-foreground mt-8 border-t px-10 pt-4 text-center text-sm">
          <p>
            <BugIcon aria-hidden="true" class="me-1 inline-block size-4 align-text-bottom" />
            {labels[post.data.locale].errorPrompt}
            {" "}
            <a
              class="link-underline hover:text-foreground"
              href={issueUrl.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              {labels[post.data.locale].reportError}
            </a>
          </p>
        </footer>
      </article>
    </main>
  </ContentWithToc>
</MainLayout>

<style>
  .reading-progress {
    display: none;
  }

  @supports (animation-timeline: scroll(root block)) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        position: fixed;
        inset: 0 0 auto;
        z-index: 100;
        display: block;
        height: 3px;
        background: var(--primary);
        pointer-events: none;
        transform: scaleX(0);
        transform-origin: left center;
        animation: grow-progress auto linear;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes grow-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>

<style is:global>
  .expressive-code .copy button {
    border-radius: 0 !important;
  }

  @media (width <= 768px) {
    .expressive-code .copy button {
      width: 1.7rem !important;
      height: 1.7rem !important;
    }
  }
</style>
