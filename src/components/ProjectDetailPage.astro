---
import { getCollection, render } from "astro:content"
import ProjectLayout from "@/layouts/ProjectLayout.astro"
import ScreenshotGallery from "@/components/ScreenshotGallery.astro"
import StackList from "@/components/StackList.astro"
import Tags from "@/components/Tags.astro"
import { getStackItemsBySlug, getTagItemsBySlug } from "@/lib/taxonomy"
import type { Project } from "@/lib/projects"

interface Props {
  project: Project
}
const { project } = Astro.props
const {
  locale,
  translationKey,
  title,
  description,
  href,
  sourceUrl,
  customFavicon,
  screenshots,
  screenshotOrientation,
} = project.data
const { Content, headings } = await render(project)
const [stack] = await getCollection("stack")
if (!stack) {
  throw new Error("Missing stack content")
}
const [tags] = await getCollection("tags")
if (!tags) {
  throw new Error("Missing tags content")
}
const stackItems = getStackItemsBySlug(stack, project.data.stack)
const tagItems = getTagItemsBySlug(tags, project.data.tags)
const hasStack = stackItems.length > 0 || tagItems.length > 0
const aiTools = project.data.aiTools
const stackHeading = {
  depth: 2,
  slug: "project-stack",
  text: locale === "es" ? "Construido con" : "Built with",
}
const aiHeading = {
  depth: 2,
  slug: "project-ai-tools",
  text: locale === "es" ? "Desarrollo asistido por IA" : "AI-assisted development",
}
const mediaHeading = { depth: 2, slug: "screenshots", text: locale === "es" ? "Capturas" : "Screenshots" }
const hasScreenshots = screenshots.length > 0
const tocHeadings = [
  ...(hasScreenshots ? [mediaHeading] : []),
  ...headings.filter(({ depth }) => depth === 2 || depth === 3),
  ...(hasStack ? [stackHeading] : []),
  ...(aiTools.length > 0 ? [aiHeading] : []),
]
const markdown = [
  `# ${title}`,
  description,
  project.body ?? "",
  ...(hasStack
    ? [
        `## ${stackHeading.text}`,
        ...(stackItems.length > 0 ? [stackItems.map((item) => item.name).join(" · ")] : []),
        ...(tagItems.length > 0 ? [tagItems.map((item) => item.name).join(" · ")] : []),
      ]
    : []),
  ...(aiTools.length > 0 ? [`## ${aiHeading.text}`, aiTools.map((item) => item.name).join(" · ")] : []),
  sourceUrl ?? "",
].join("\n\n")
---

<ProjectLayout
  description={description}
  headings={tocHeadings}
  href={href}
  lead={description}
  locale={locale}
  logo={project.data.logo?.src ?? customFavicon}
  markdown={markdown}
  pageTitle={`${title}: ${description}`}
  slug={translationKey}
  sourceUrl={sourceUrl}
  title={title}
>
  <div
    class="prose prose-neutral prose-sm dark:prose-invert prose-p:text-muted-foreground prose-headings:text-balance lg:prose-base max-w-none"
  >
    {
      hasScreenshots && (
        <section aria-labelledby="screenshots" data-toc-section style="view-timeline-name: --toc-section-0">
          <h2 id="screenshots">{mediaHeading.text}</h2>
          <div class="not-prose">
            <ScreenshotGallery
              id={`${translationKey}-screenshots`}
              locale={locale}
              orientation={screenshotOrientation}
              screenshots={screenshots}
            />
          </div>
        </section>
      )
    }
    <Content />
    {
      hasStack && (
        <section
          aria-labelledby={stackHeading.slug}
          data-toc-section
          style={`view-timeline-name: --toc-section-${tocHeadings.indexOf(stackHeading)}`}
        >
          <h2 id={stackHeading.slug}>{stackHeading.text}</h2>
          {stackItems.length > 0 && <StackList stackItems={stackItems} />}
          {tagItems.length > 0 && <Tags class="not-prose mt-3" tags={tagItems} />}
        </section>
      )
    }
    {
      aiTools.length > 0 && (
        <section
          aria-labelledby={aiHeading.slug}
          data-toc-section
          style={`view-timeline-name: --toc-section-${tocHeadings.indexOf(aiHeading)}`}
        >
          <h2 id={aiHeading.slug}>{aiHeading.text}</h2>
          <StackList stackItems={aiTools} />
        </section>
      )
    }
  </div>
</ProjectLayout>
