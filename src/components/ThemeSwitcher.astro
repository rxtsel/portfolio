---
import MoonIcon from "@/assets/moon.svg"
import SunIcon from "@/assets/soon.svg"
import type { Locale } from "@/lib/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const labels = {
  en: { light: "Switch to light theme", dark: "Switch to dark theme" },
  es: { light: "Cambiar a tema claro", dark: "Cambiar a tema oscuro" },
}[locale]
---

<button
  aria-label={labels.dark}
  class="bg-background ring-border text-foreground hover:bg-accent focus-visible:ring-ring/50 inline-grid size-8 place-items-center ring-1 transition-colors outline-none ring-inset focus-visible:ring-3 [&_svg]:size-4"
  data-dark-label={labels.dark}
  data-light-label={labels.light}
  data-theme-toggle
  type="button"
>
  <SunIcon
    aria-hidden="true"
    class="feedback-icon pointer-events-none col-start-1 row-start-1"
    data-theme-icon="light"
  />
  <MoonIcon
    aria-hidden="true"
    class="feedback-icon pointer-events-none col-start-1 row-start-1"
    data-theme-icon="dark"
  />
</button>

<style is:global>
  html[data-theme-mode="dark"] [data-theme-icon="light"],
  html[data-theme-mode="light"] [data-theme-icon="dark"] {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  @media (prefers-color-scheme: light) {
    html:not([data-theme-mode="light"]):not([data-theme-mode="dark"]) [data-theme-icon="dark"] {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  @media (prefers-color-scheme: dark) {
    html:not([data-theme-mode="light"]):not([data-theme-mode="dark"]) [data-theme-icon="light"] {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }
</style>
