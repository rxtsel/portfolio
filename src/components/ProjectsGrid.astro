---
import type { ImageMetadata } from "astro"
import ProjectCard from "@/components/ProjectCard.astro"
import { getProjectPage } from "@/lib/project-pages"
import { getProjectDetailPath, getProjectTransitionName, type Project } from "@/lib/projects"

type TaxonomyItem = {
  name: string
}

interface ProjectItem extends Project {
  taxonomyItems: TaxonomyItem[]
}

interface Props {
  faviconLoading?: "lazy" | "eager"
  headingLevel?: "h2" | "h3"
  projects: ProjectItem[]
}

const { faviconLoading = "lazy", headingLevel = "h3", projects } = Astro.props
const logos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/projects/*.webp", { eager: true })
---

<ul class="not-prose grid grid-cols-1 gap-0 sm:gap-2">
  {
    projects.map((project) => {
      const page = getProjectPage(project.data.translationKey)
      const detailPath = getProjectDetailPath(project)
      const favicon = page
        ? logos[`/${page.logoPath}`]?.default
        : (project.data.logo ?? project.data.customFavicon)
      if (page && !favicon) {
        throw new Error(`Missing project page logo: ${page.logoPath}`)
      }

      return (
        <li class="border odd:border-0 odd:border-x first-of-type:border-t last-of-type:border-b sm:odd:border">
          <ProjectCard
            customFavicon={favicon}
            description={project.data.description}
            faviconBackground={project.data.faviconBackground}
            faviconLoading={faviconLoading}
            headingLevel={headingLevel}
            href={detailPath ?? project.data.href}
            sourceUrl={project.data.sourceUrl as string}
            taxonomyItems={project.taxonomyItems}
            title={project.data.title}
            transitionNames={
              detailPath
                ? {
                    title: getProjectTransitionName(project, "title"),
                    source: getProjectTransitionName(project, "source"),
                    ...(favicon ? { logo: getProjectTransitionName(project, "logo") } : {}),
                  }
                : {
                    card: getProjectTransitionName(project, "card"),
                    description: getProjectTransitionName(project, "description"),
                    source: getProjectTransitionName(project, "source"),
                    tags: getProjectTransitionName(project, "tags"),
                    title: getProjectTransitionName(project, "title"),
                  }
            }
          />
        </li>
      )
    })
  }
</ul>
