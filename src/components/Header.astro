---
import Logo from "@/assets/logo.svg"
import {
  getDefaultLanguageLinks,
  getLocaleLanguageTag,
  getLocaleLabel,
  getLocalizedPath,
  type LanguageLink,
  type Locale,
} from "@/lib/i18n"

import Separator from "@/components/Separator.astro"
import ThemeSwitcher from "@/components/ThemeSwitcher.astro"

interface Props {
  languageLinks?: LanguageLink[] | undefined
  locale: Locale
  pathname: string
}

const { languageLinks, locale, pathname } = Astro.props
const links = languageLinks ?? getDefaultLanguageLinks()
const logoHref = getLocalizedPath(locale)
const blogHref = getLocalizedPath(locale, "blog")
const projectsHref = getLocalizedPath(locale, locale === "es" ? "proyectos" : "projects")
const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/"
const normalizedPathname = normalizePath(pathname)
const normalizedBlogHref = normalizePath(blogHref)
const normalizedProjectsHref = normalizePath(projectsHref)
const isProjectsIndexActive = normalizedPathname === normalizedProjectsHref
const isProjectsActive = isProjectsIndexActive || normalizedPathname.startsWith(`${normalizedProjectsHref}/`)
const isBlogIndexActive = normalizedPathname === normalizedBlogHref
const isBlogActive = isBlogIndexActive || normalizedPathname.startsWith(`${normalizedBlogHref}/`)
const isNotFoundRoute = Astro.routePattern === "/404"
const navLinkClass =
  "text-muted-foreground cursor-pointer hover:text-foreground data-active:text-foreground inline-flex h-8 items-center text-sm font-medium transition-colors"
const languageLinkClass =
  "text-muted-foreground hover:text-foreground data-active:text-foreground inline-flex h-8 items-center text-sm font-medium transition-colors"
const labels = {
  en: {
    language: "Language selector",
    primary: "Primary",
    projects: "Projects",
  },
  es: {
    language: "Selector de idioma",
    primary: "Principal",
    projects: "Proyectos",
  },
} satisfies Record<Locale, Record<string, string>>
---

<header class="bg-background sticky top-0 z-50 flex items-center justify-between py-4" id="header">
  <a class="logo" href={logoHref}>
    <Logo aria-label="Rxtsel logo" height={30} width={29} />
  </a>

  <div class="flex items-center gap-2">
    <nav aria-label={labels[locale].primary} class="flex items-center gap-2">
      <a
        aria-current={isProjectsIndexActive ? "page" : isProjectsActive ? "location" : undefined}
        class:list={navLinkClass}
        data-active={isProjectsActive ? true : undefined}
        href={projectsHref}
      >
        {labels[locale].projects}
      </a>
      <span aria-hidden="true" class="bg-muted-foreground/50 size-0.5 shrink-0 rounded-full"></span>
      <a
        aria-current={isBlogActive ? "page" : undefined}
        class:list={navLinkClass}
        data-active={isBlogActive ? true : undefined}
        href={blogHref}
      >
        Blog
      </a>
    </nav>

    {
      !isNotFoundRoute && (
        <>
          <Separator />

          <nav aria-label={labels[locale].language} class="flex items-center gap-x-1">
            {links.map((link, index) => (
              <>
                {index > 0 && (
                  <span aria-hidden="true" class="text-muted-foreground/40 text-sm">
                    /
                  </span>
                )}
                {link.locale === locale ? (
                  <span
                    aria-current="true"
                    aria-label={getLocaleLabel(link.locale)}
                    class:list={languageLinkClass}
                    data-active
                    lang={getLocaleLanguageTag(link.locale)}
                  >
                    {link.locale.toUpperCase()}
                  </span>
                ) : (
                  <a
                    aria-label={getLocaleLabel(link.locale)}
                    class:list={languageLinkClass}
                    href={link.href}
                    hreflang={getLocaleLanguageTag(link.locale)}
                    lang={getLocaleLanguageTag(link.locale)}
                  >
                    {link.locale.toUpperCase()}
                  </a>
                )}
              </>
            ))}
          </nav>
        </>
      )
    }

    <Separator />

    <ThemeSwitcher locale={locale} />
  </div>
</header>

<style>
  #header {
    animation: blur linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes blur {
    to {
      --tw-shadow: 0 1px var(--tw-shadow-color, rgb(0 0 0 / 0.05));
      box-shadow:
        var(--tw-inset-shadow), var(--tw-inset-ring-shadow), var(--tw-ring-offset-shadow),
        var(--tw-ring-shadow), var(--tw-shadow);
    }
  }
</style>
