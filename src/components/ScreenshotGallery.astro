---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"
import CloseIcon from "@/assets/close.svg"
import ArrowIcon from "@/assets/arrow.svg"
import type { Locale } from "@/lib/i18n"
import { getScreenshotPlaceholderCount, type ScreenshotOrientation } from "@/lib/screenshots"

interface Props {
  id: string
  locale: Locale
  screenshots: { src: ImageMetadata; title: string; alt: string }[]
  orientation: ScreenshotOrientation
}

const { id, locale, screenshots, orientation } = Astro.props
const placeholders = getScreenshotPlaceholderCount(screenshots.length, orientation)
const singleHorizontal = orientation === "horizontal" && screenshots.length === 1
const labels = {
  en: {
    gallery: "Project screenshots",
    placeholder: "Screenshot not yet available",
    open: "Enlarge screenshot",
    close: "Close screenshot",
    previous: "Previous screenshot",
    next: "Next screenshot",
    loading: "Loading screenshot…",
  },
  es: {
    gallery: "Capturas del proyecto",
    placeholder: "Captura aún no disponible",
    open: "Ampliar captura",
    close: "Cerrar captura",
    previous: "Captura anterior",
    next: "Siguiente captura",
    loading: "Cargando captura…",
  },
}[locale]
---

<div data-loading-label={labels.loading} data-orientation={orientation} data-screenshot-gallery>
  <ul aria-label={labels.gallery} class="gallery-strip">
    {
      screenshots.map((screenshot, index) => {
        const dialogId = `${id}-${index}`
        return (
          <li class="gallery-shot" style={`--shot-name: shot-${dialogId}`}>
            <a
              aria-controls={id}
              aria-haspopup="dialog"
              aria-label={`${labels.open}: ${screenshot.title}`}
              class="gallery-link"
              data-screenshot-open={dialogId}
              href={screenshot.src.src}
            >
              <Image
                alt={screenshot.alt}
                class="gallery-thumbnail"
                format="webp"
                loading={index < 4 ? "eager" : "lazy"}
                quality={90}
                sizes={
                  singleHorizontal
                    ? "(min-width: 640px) 640px, 100vw"
                    : orientation === "vertical"
                      ? "(min-width: 640px) 160px, 42vw"
                      : "(min-width: 640px) 320px, 85vw"
                }
                src={screenshot.src}
                width={singleHorizontal ? 1280 : orientation === "vertical" ? 480 : 960}
                widths={
                  singleHorizontal
                    ? [320, 640, 1280]
                    : orientation === "vertical"
                      ? [160, 320, 480]
                      : [320, 640, 960]
                }
              />
              <span class="gallery-caption">{screenshot.title}</span>
            </a>
          </li>
        )
      })
    }
    {
      Array.from({ length: placeholders }, () => (
        <li class="gallery-shot">
          <div aria-label={labels.placeholder} class="gallery-placeholder" role="img" />
        </li>
      ))
    }
  </ul>
  {
    screenshots.length > 0 && (
      <dialog aria-label={labels.gallery} closedby="any" data-gallery-dialog id={id}>
        <header class="gallery-dialog-header">
          {screenshots.length > 1 && (
            <div class="gallery-dialog-controls">
              <button aria-label={labels.previous} data-gallery-previous disabled type="button">
                <ArrowIcon aria-hidden="true" class="-rotate-90" />
              </button>
              <button aria-label={labels.next} data-gallery-next type="button">
                <ArrowIcon aria-hidden="true" class="rotate-90" />
              </button>
            </div>
          )}
          <form method="dialog">
            <button aria-label={labels.close} data-gallery-close type="submit">
              <CloseIcon aria-hidden="true" />
            </button>
          </form>
        </header>
        <ul aria-label={labels.gallery} class="gallery-slides" data-gallery-slides>
          {screenshots.map((screenshot, index) => (
            <li
              aria-hidden={index !== 0 ? "true" : "false"}
              class="gallery-slide"
              data-active={index === 0 ? "" : undefined}
              data-screenshot-title={screenshot.title}
            >
              <img
                alt={screenshot.alt}
                class="gallery-full-image"
                data-src={screenshot.src.src}
                decoding="async"
                draggable="false"
                height={screenshot.src.height}
                width={screenshot.src.width}
              />
            </li>
          ))}
        </ul>
      </dialog>
    )
  }
  <span class="sr-only" data-gallery-status role="status"></span>
</div>

<script src="../scripts/screenshot-gallery.ts"></script>

<style>
  .gallery-link:global([aria-busy="true"]) {
    cursor: progress;
  }

  .gallery-link:global([aria-busy="true"]) :global(.gallery-thumbnail) {
    opacity: 0.55;
    transition: opacity 0s 800ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery-link:global([aria-busy="true"]) :global(.gallery-thumbnail) {
      animation: gallery-loading-pulse 1.2s ease-in-out 800ms infinite;
    }
  }

  @keyframes gallery-loading-pulse {
    from,
    to {
      opacity: 0.45;
    }
    50% {
      opacity: 0.85;
    }
  }

  .gallery-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 42%;
    gap: 0.75rem;
    margin: 0;
    padding: 0.25rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
  }

  [data-orientation="horizontal"] .gallery-strip {
    grid-auto-columns: 85%;
  }

  .gallery-placeholder {
    aspect-ratio: 9 / 19.5;
    border: 1px solid var(--border);
    background: repeating-linear-gradient(135deg, transparent 0 7px, var(--border) 7px 8px);
  }

  [data-orientation="horizontal"] .gallery-placeholder {
    aspect-ratio: 16 / 10;
  }

  [data-orientation="horizontal"] .gallery-link :global(.gallery-thumbnail) {
    aspect-ratio: 16 / 10;
    object-fit: contain;
  }

  [data-orientation="horizontal"] .gallery-full-image {
    border-radius: 0.5rem;
  }

  [data-orientation="horizontal"] .gallery-strip:has(> :only-child) {
    grid-auto-columns: 100%;
  }

  [data-orientation="horizontal"] .gallery-strip:has(> :only-child) :global(.gallery-thumbnail) {
    aspect-ratio: auto;
  }

  .gallery-strip::-webkit-scrollbar {
    display: none;
  }

  .gallery-shot {
    min-width: 0;
    scroll-snap-align: start;
  }

  .gallery-link {
    display: block;
    color: var(--muted-foreground);
    text-decoration: none;
    cursor: zoom-in;
  }

  .gallery-link:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
  }

  .gallery-link :global(.gallery-thumbnail) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
  }

  .gallery-caption {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  [data-screenshot-gallery]:not(:has(dialog:modal))
    .gallery-shot:global([data-transitioning])
    :global(.gallery-thumbnail) {
    view-transition-name: var(--shot-name);
  }

  dialog {
    width: calc(100vw - 2rem);
    max-width: 100%;
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    overflow: visible;
    color: #fff;
    background: transparent;
    border: 0;
  }

  [data-orientation="vertical"] dialog {
    width: min(calc(100vw - 2rem), max(9rem, calc((100dvh - 8rem) * 9 / 19.5)));
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 80%);
  }

  dialog:global([aria-busy="true"]) {
    cursor: progress;
  }

  .gallery-slides {
    display: flex;
    height: calc(100dvh - 8rem);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }

  .gallery-slides::-webkit-scrollbar {
    display: none;
  }

  .gallery-slide {
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    justify-content: center;
    min-width: 0;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .gallery-dialog-controls {
    display: flex;
    gap: 0.25rem;
  }

  .gallery-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .gallery-dialog-header form {
    margin-left: auto;
  }

  .gallery-dialog-header button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: #d4d4d8;
    background: transparent;
    border: 0;
  }

  .gallery-dialog-header button:hover:not(:disabled) {
    color: #fff;
  }

  .gallery-dialog-header button:disabled {
    opacity: 0.35;
  }

  .gallery-dialog-header button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .gallery-dialog-header :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .gallery-full-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    margin-inline: auto;
    object-fit: contain;
    background: #000;
    border: 6px solid #27272a;
    border-radius: min(2.5rem, 5dvh);
    outline: 1px solid #52525b;
  }

  dialog:global([data-transitioning]):modal .gallery-slide:global([data-active]) .gallery-full-image {
    view-transition-name: var(--shot-name);
  }

  /* Keep viewport geometry stable from the opening snapshot through the closing animation. */
  :global(html:has([data-screenshot-gallery] :is(dialog:modal, [data-transitioning]))) {
    overflow: hidden;
    scrollbar-gutter: auto;
  }

  /* Keep page identities in the backdrop snapshot without creating a nested scroll container. */
  :global(body:has([data-screenshot-gallery] :is(dialog:modal, [data-transitioning]))) {
    --project-identity-transition: none;
    overflow: visible;
  }

  @media (width >= 640px) {
    .gallery-strip {
      grid-auto-columns: calc((100% - 2.25rem) / 4);
    }

    .gallery-strip:has(> :nth-child(5)) {
      grid-auto-columns: calc((100% - 3rem) / 4.25);
    }

    [data-orientation="horizontal"] .gallery-strip {
      grid-auto-columns: calc((100% - 0.75rem) / 2);
    }

    [data-orientation="horizontal"] .gallery-strip:has(> :nth-child(3)) {
      grid-auto-columns: calc((100% - 1.5rem) / 2.15);
    }
  }
</style>
